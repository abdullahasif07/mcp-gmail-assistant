# Only needed when running the MCP server standalone (e.g. `npm start` or
# wiring it into an MCP client like Claude Desktop). When launched by the
# backend, these are injected per request with the signed-in user's token.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
