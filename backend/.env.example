# Copy to backend/.env and fill in. Variables without a default are required;
# the backend refuses to start if any are missing.

# "dev" = SameSite=Lax cookies over plain http://localhost.
# "prod" = SameSite=None; Secure cookies (needed when frontend and backend
#          are on different domains, e.g. Vercel + Render).
ENV=dev

# ── Gemini (https://aistudio.google.com/app/apikey) ─────────────────────
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash

# ── Google OAuth 2.0 Web client ─────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials. Enable the Gmail API.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must EXACTLY match an "Authorized redirect URI" on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/callback

# ── Frontend / CORS ─────────────────────────────────────────────────────
# Where the browser is sent after signing in.
FRONTEND_BASE_URL=http://localhost:3000
# Extra allowed CORS origins, comma-separated (localhost:3000 is implicit).
# FRONTEND_ORIGIN=https://mailmind.example.com

# ── Secrets ─────────────────────────────────────────────────────────────
# Signs the session cookie. At least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_JWT_SECRET=
# Encrypts stored Gmail refresh tokens. Must be a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Optional shared-secret header (X-API-Key). Empty disables the check.
# If set, build the frontend with the same NEXT_PUBLIC_API_KEY.
API_KEY=

# ── Recruiter demo mode ─────────────────────────────────────────────────
# Sandboxed fake inbox with fictional, pre-seeded emails (no Gmail needed).
# DEMO_ENABLED=true
# If set, visitors must enter this code on the landing page to start the demo.
DEMO_ACCESS_CODE=

# ── AI cost guards ──────────────────────────────────────────────────────
# Max AI requests (chat messages + reply suggestions) per UTC day, app-wide.
# 0 = unlimited.
# AI_DAILY_LIMIT=300
# Max AI requests per demo session.
# DEMO_SESSION_AI_LIMIT=30

# ── Storage ─────────────────────────────────────────────────────────────
# SQLite file holding one encrypted refresh token per connected account.
# DB_PATH=./mailmind.db
